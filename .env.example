# URL de base de l'API utilisée par le frontend (par défaut : /api, relayé par nginx vers backend:5000)
VITE_API_URL=/api

# Mode démonstration (backend simulé si l'API est injoignable) : actif en développement,
# désactivé dans l'image Docker de production (Dockerfile : VITE_ENABLE_DEMO=false).
# VITE_ENABLE_DEMO=true

# ---- Docker Hub ----
DOCKERHUB_USER=user
BACKEND_TAG=latest
FRONTEND_TAG=latest
